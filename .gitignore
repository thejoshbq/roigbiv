# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
dist/
build/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.conda/

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Claude IDE (local settings only — project memories stay tracked) ──────────
.claude/settings.local.json
.claude/scheduled_tasks.lock

# ── Local test workspace (generated, multi-GB; not checked in) ───────────────
# test_raw/  — raw TIF inputs used for local smoke tests (~4 GB)
# test_output/ — pipeline-generated summary/stage artifacts (~13 GB)
test_raw/
test_output/

# ── Data (raw TIF/HDF5 stacks, annotations, all intermediates) ───────────────
# The ENTIRE data/ tree is too large for git (multi-TB raw acquisitions +
# annotations, stored on the external drive) and pipeline intermediates are
# regenerable. Blanket-ignored so a stray `git add` can never stage it — an
# accidental add of this tree previously bloated .git to ~500 GB.
data/

# ── Top-level generated output / scratch (root-anchored; regenerable) ────────
# Pipeline run outputs and scratch dirs that live at the repo root. Root-anchored
# so nested `output/` workspace dirs under already-ignored trees are unaffected.
/output/
/onnx/
/results/

# ── Suite2p workspace (intermediate outputs, ~11 GB) ─────────────────────────
# Contains .npy stat arrays, .bin binary stacks, .tif masks — all generated.
suite2p_workspace/

# ── Inference outputs (generated by pipeline) ────────────────────────────────
inference/output/
inference/consensus/
inference/traces/
inference/pipeline/

# ── Registry runtime artifacts (SQLite DBs, fingerprint blobs, calibration) ──
# Populated by roigbiv-registry at runtime from the pipeline outputs and
# ROICaT embeddings; regenerable via `roigbiv-registry backfill`.
inference/*.db
inference/*.db-wal
inference/*.db-shm
inference/*.db-journal
inference/fingerprints/
inference/fingerprints_v3/
inference/registry_calibration.json

# ── Model training checkpoints (~13 GB, 500+ files at ~26 MB each) ───────────
# Only the deployed model is needed; it is tracked via Git LFS (.gitattributes).
models/checkpoints/

# ── Experiment outputs (benchmark/diagnostic runs, logs, vendored clones) ─────
# Generated by ad-hoc benchmarking and validation harnesses; not data of record.
# Only hand-written driver scripts (*.py, *.md) under experiments/ are tracked;
# their multi-GB run artifacts, logs, and vendored repos are ignored.
experiments/runs/
experiments/*/run_*/
experiments/*/_vendor/
experiments/*/*.log

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/*.log

# ── Temporary files ───────────────────────────────────────────────────────────
*.tmp
*.temp
tmp/
